# FinAlly environment configuration.
# Copy to .env and fill in your keys. The .env file is gitignored - never commit it.

# Required: OpenRouter API key for LLM chat functionality.
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: Massive (Polygon.io) API key for real market data.
# Set and non-empty -> backend polls the Massive REST API for prices.
# Absent or empty    -> backend uses the built-in market simulator (recommended).
MASSIVE_API_KEY=

# Optional: deterministic mock LLM responses instead of calling OpenRouter.
# true  -> no API key needed, fixed responses (used by the E2E tests).
# false -> real LLM calls via OpenRouter.
LLM_MOCK=false
